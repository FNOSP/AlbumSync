@@ -242,6 +242,38 @@
             pass
         os.replace(tmp, self.cookie_jar_path)
 
+    def persist_cookie_jar_if_changed(self) -> bool:
+        """Persist the in-memory cookie jar only when it differs from disk (T28.3).
+
+        Keepalive heartbeats may receive rotated CASTGC cookies that only land
+        in the in-memory jar; persisting unconditionally would rewrite the lwp
+        file every cycle for no reason. Serialize to a scratch file, compare
+        with the on-disk jar, and save atomically only on a real diff.
+        """
+        try:
+            if not any(self._cookie_jar):
+                return False
+            cmp_path = self.cookie_jar_path.with_name(f".cas_cookies.{os.getpid()}.cmp")
+            try:
+                self._cookie_jar.save(str(cmp_path), ignore_discard=True, ignore_expires=False)
+                new_content = cmp_path.read_bytes() if cmp_path.exists() else b""
+            finally:
+                try:
+                    cmp_path.unlink(missing_ok=True)
+                except OSError:
+                    pass
+            if self.cookie_jar_path.exists():
+                try:
+                    if self.cookie_jar_path.read_bytes() == new_content:
+                        return False
+                except OSError:
+                    pass
+            self._save_cookie_jar()
+            return True
+        except Exception as exc:
+            logger.debug("persist_cookie_jar_if_changed failed: %s", exc)
+            return False
+
     @contextmanager
     def _acquire_lock(self, timeout_sec: float = 30.0) -> Iterator[None]:
         self.lock_file.parent.mkdir(parents=True, exist_ok=True)

+def _sha256_of_file(path: Path) -> str:
+    """流式计算文件 sha256（T44.1 账本补齐用；账本列 NOT NULL 必须给真实值）。"""
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
